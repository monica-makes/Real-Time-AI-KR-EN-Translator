# Deepgram API key for speech-to-text (supports both Korean and English)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API key for translation (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API key for text-to-speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice IDs for each language
# Find voices at: https://elevenlabs.io/voice-library
ELEVENLABS_KOREAN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_ENGLISH_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
